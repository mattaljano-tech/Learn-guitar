<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ng_jam_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="2dp">
    <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitCenter" android:src="@drawable/ng_jam_icon" android:contentDescription="Jamma" />
    <TextView android:id="@+id/ng_jam_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="Jamma" android:textColor="#FFFFFF" android:textSize="13sp" android:shadowColor="#99000000" android:shadowRadius="4" />
</LinearLayout>
