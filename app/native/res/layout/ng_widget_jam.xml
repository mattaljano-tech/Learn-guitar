<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ng_jam_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="4dp">
    <ImageView android:id="@+id/ng_jam_img" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitCenter" android:src="@drawable/ng_jam_icon" android:contentDescription="Jamma" />
    <Chronometer android:id="@+id/ng_jam_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FF6B5E" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/ng_jam_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="Jamma" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" />
    <TextView android:id="@+id/ng_jam_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp"
        android:text="Öppna appen" android:textColor="#CCFFFFFF" android:textSize="11sp" android:shadowColor="#99000000" android:shadowRadius="4" />
</LinearLayout>
