<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ng_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:gravity="center" android:background="@drawable/ng_widget_bg">
    <TextView android:id="@+id/ng_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0" android:textColor="#F2C230" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/ng_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="dagar i rad" android:textColor="#FBF2DC" android:textSize="12sp" />
    <TextView android:id="@+id/ng_goal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/ng_level" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/ng_button" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="6dp"
        android:gravity="center" android:text="Kör igång" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
        android:background="@drawable/ng_widget_btn" />
</LinearLayout>
